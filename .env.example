WEIGHT_FREQUENCY=0.20
WEIGHT_SIMILARITY=0.25
WEIGHT_RECENCY=0.15
WEIGHT_REUSE=0.20
WEIGHT_COST=0.10
WEIGHT_MEMORY=0.10

API_PORT=8000
