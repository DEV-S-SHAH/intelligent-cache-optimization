CACHE_EXACT_TTL=3600
CACHE_SEMANTIC_TTL=86400
CACHE_CONTEXT_TTL=1800
CACHE_TOOL_TTL=7200

CACHE_SEMANTIC_THRESHOLD=0.85
CACHE_MAX_SIZE=10000
CACHE_LRU_EVICTION=true

MOCK_LLM_DELAY_MS=1000
CACHE_SCORE_THRESHOLD=0.5
CACHE_SHORT_TTL=300
